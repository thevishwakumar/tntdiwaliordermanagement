# ==============================================================================
# TNT DIWALI ORDER MANAGEMENT SYSTEM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=3000

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=

# Public Anon Key (Safe for frontend access with Row Level Security)
SUPABASE_ANON_KEY=

# Service Role Secret Key (Strictly backend only - NEVER expose in client files)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# RAZORPAY CONFIGURATION
# ------------------------------------------------------------------------------
# Razorpay Key ID (e.g. rzp_test_...) - Safe for frontend checkout script
RAZORPAY_KEY_ID=

# Razorpay Key Secret (Strictly backend only - used for HMAC SHA256 signature verification)
RAZORPAY_KEY_SECRET=
